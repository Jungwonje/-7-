<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.hsu_lendit"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="35" />

    <permission
        android:name="com.example.hsu_lendit.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.hsu_lendit.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.HSU_lendIt" >

        <!-- MainActivity: 앱 시작화면 -->
        <activity
            android:name="com.example.hsu_lendit.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SecondActivity: 물품 대여 화면 -->
        <activity android:name="com.example.hsu_lendit.SecondActivity" />

        <!-- MyPageActivity: 마이페이지 화면 -->
        <activity android:name="com.example.hsu_lendit.MyPageActivity" />

        <!-- RentChargerActivity: 충전기 대여 화면 -->
        <activity android:name="com.example.hsu_lendit.RentChargerActivity" />

        <!-- RentEarphoneActivity: 이어폰 대여 화면 -->
        <activity android:name="com.example.hsu_lendit.RentEarphoneActivity" />

        <!-- RentLaptopActivity: 노트북 대여 화면 -->
        <activity android:name="com.example.hsu_lendit.RentLaptopActivity" />

        <!-- RentMouseActivity: 마우스 대여 화면 -->
        <activity android:name="com.example.hsu_lendit.RentMouseActivity" />

        <!-- RentScissorsActivity: 가위 대여 화면 -->
        <activity android:name="com.example.hsu_lendit.RentScissorsActivity" />

        <!-- RentTabletActivity: 태블릿 대여 화면 -->
        <activity android:name="com.example.hsu_lendit.RentTabletActivity" />

        <!-- RentUmbrellaActivity: 우산 대여 화면 -->
        <activity android:name="com.example.hsu_lendit.RentUmbrellaActivity" />

        <!-- OutOfStockActivity: 재고 부족 화면 -->
        <activity android:name="com.example.hsu_lendit.OutOfStockActivity" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.hsu_lendit.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>