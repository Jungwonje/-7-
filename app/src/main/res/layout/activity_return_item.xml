<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvReturnInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="반납할 물품 정보를 입력하세요."
        android:textSize="18sp"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/etItemType"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:hint="물품 종류 (예: 가위)"
        android:inputType="text" />

    <EditText
        android:id="@+id/etItemId"
        android:layout_width="match_parent"
        android:layout_height="81dp"
        android:hint="고유 ID (예: A)"
        android:inputType="text" />

    <Button
        android:id="@+id/btnConfirmReturn"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:text="반납 완료" />

    <Button
        android:id="@+id/btnCancelReturn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="취소" />
</LinearLayout>