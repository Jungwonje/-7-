<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- 마이페이지 버튼 (작고 오른쪽 상단) -->
    <Button
        android:id="@+id/btnMyPage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:backgroundTint="@android:color/holo_blue_dark"
        android:text="마이페이지"
        android:textColor="@android:color/white"
        android:textSize="12sp" />

    <!-- 환영 메시지 (가운데 상단) -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnMyPage"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="환영합니다!"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 제목 텍스트 (환영 메시지 아래) -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="물품 대여 목록"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_below="@id/tvWelcome"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp" />

    <!-- 물품 목록 스크롤뷰 -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/titleText"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/itemContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 물품 항목 (가위) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/scissors"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="가위"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvScissorsRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="남은 수량: 5"
                        android:textSize="16sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- 대여하기 버튼 -->
                <Button
                    android:id="@+id/btnRentScissors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="대여하기"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- 물품 항목 (노트북) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="97dp"
                android:layout_marginBottom="8dp"
                android:background="#EEEEEE"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/laptop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="노트북"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="남은 수량: 3"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- 대여하기 버튼 -->
                <Button
                    android:id="@+id/btnRentLaptop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="대여하기"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- 마우스 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/mouse"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="마우스"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="남은 수량: 0"
                        android:textSize="16sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- 대여하기 버튼 추가 -->
                <Button
                    android:id="@+id/btnRentMouse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="대여하기"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- 이어폰 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/earphone"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="이어폰"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="남은 수량: 6"
                        android:textSize="16sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- 대여하기 버튼 추가 -->
                <Button
                    android:id="@+id/btnRentEarphone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="대여하기"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- 우산 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/umbrella"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="우산"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="남은 수량: 4"
                        android:textSize="16sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- 대여하기 버튼 추가 -->
                <Button
                    android:id="@+id/btnRentUmbrella"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="대여하기"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- 충전기 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/charger"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="충전기"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="남은 수량: 2"
                        android:textSize="16sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- 대여하기 버튼 추가 -->
                <Button
                    android:id="@+id/btnRentCharger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="대여하기"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- 태블릿 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/tablet"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="태블릿"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="남은 수량: 3"
                        android:textSize="16sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- 대여하기 버튼 추가 -->
                <Button
                    android:id="@+id/btnRentTablet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="대여하기"
                    android:layout_marginStart="8dp" />

            </LinearLayout>


        </LinearLayout>
    </ScrollView>
</RelativeLayout>
